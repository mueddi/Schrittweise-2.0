{
  "name": "Kniff",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/run.sh",
  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": { "label": "Kniff App", "onAutoForward": "notify" },
    "8000": { "label": "Kniff API", "onAutoForward": "silent" }
  }
}
